            {
              "name": "anger_after",
              "label": "之后怒气",
              "type": "number",
              "min": 0,
              "max": 100,
              "unit": "%"
            }
          ]
        }
      ],
      "example": {
        "body_signals": [
          "咬紧牙",
          "胸口发紧"
        ],
        "pause_phrase": "“这事我们晚点再聊，我先去倒杯水。”",
        "self_care_action": "到阳台站 3 分钟，喝杯温水"
      }
    },
    {
      "id": "conflict_review",
      "title": "冲突后复盘表",
      "category": "事后",
      "when_to_use": "吵架、发火或憋着生闷气之后，等情绪降下来（通常是当晚或第二天）再填。",
      "how_to_fill": "先把“生气”拆成更精确的情绪词，再看当时的冲动和实际反应，最后写下一句能说出口的需要。目的是下次做得不一样，不是给自己定罪。",
      "sources": [
        {
          "book": "《抑郁症自救手册》（莫妮克·汤普森）",
          "chapter": "第5章",
          "note": "策略 9 标记情绪（表 5.1 词库节选）、策略 10 情绪如何影响生活、STOP 复盘问题"
        },
        {
          "book": "《伯恩斯新情绪疗法》（戴维·伯恩斯）",
          "chapter": "第7、8章",
          "note": "准确地移情；为行为道歉，懊悔而不是内疚"
        },
        {
          "book": "《焦虑症与恐惧症手册》第6版（艾德蒙·伯恩）",
          "chapter": "第12、14章",
          "note": "识别和表达情绪；基本需要"
        }
      ],
      "sections": [
