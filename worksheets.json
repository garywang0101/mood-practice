{
  "schema_version": "1.0",
  "title": "情绪练习表",
  "language": "zh-CN",
  "description": "根据四本自助书的读书笔记整理的精选练习表。仅供自助练习，不能代替医生和心理咨询师。不含任何有版权量表的原题。",
  "field_types": {
    "text": "单行文字",
    "textarea": "多行文字，print_lines 为打印时预留行数",
    "number": "数字，含 min/max，unit 为单位（可选）",
    "single_choice": "单选，options",
    "multi_choice": "多选，options；allow_other=true 时允许自填其他",
    "date": "日期 YYYY-MM-DD",
    "datetime": "日期和时间 YYYY-MM-DDTHH:MM",
    "time": "时间 HH:MM"
  },
  "structure_notes": "每张表的 sections 为字段分组；repeatable=true 表示可重复添加多条记录（打印版按 print_rows 画行）。example 的键对应字段 name；可重复分组在 example 中用分组 id 为键、值为对象数组。steps / reference / weeks 是只读说明内容，不需要填写。",
  "sources": [
    "《伯恩斯新情绪疗法》（戴维·伯恩斯）",
    "《抑郁症的正念认知疗法》第2版（西格尔、威廉斯、蒂斯代尔）",
    "《焦虑症与恐惧症手册》第6版（艾德蒙·伯恩）",
    "《抑郁症自救手册》（莫妮克·汤普森）"
  ],
  "worksheets": [
    {
      "id": "daily_checkin",
      "title": "每日情绪与练习打卡",
      "category": "每天",
      "when_to_use": "每天睡前花 2 分钟。看的是一周里的变化趋势，不评判某一天。",
      "how_to_fill": "给今天的心情、烦躁、焦虑各打一个 0–10 的分，勾出今天做过的练习，再写一件小事。这不是诊断量表，只是自己的记录。",
      "sources": [
        {
          "book": "《伯恩斯新情绪疗法》（戴维·伯恩斯）",
          "chapter": "第2章",
          "note": "书中建议像称体重一样定期记录情绪变化；本表只是自评打分，不含书中量表原题"
        },
        {
          "book": "《抑郁症的正念认知疗法》第2版（西格尔、威廉斯、蒂斯代尔）",
          "chapter": "第7–17章",
          "note": "每天短时间、有规律的练习"
        },
        {
          "book": "《抑郁症自救手册》（莫妮克·汤普森）",
          "chapter": "第10章",
          "note": "复发信号，每周对照一次"
        }
      ],
      "sections": [
        {
          "id": "day",
          "title": "一周记录",
          "repeatable": true,
          "print_rows": 7,
          "fields": [
            {
              "name": "date",
              "label": "日期",
              "type": "date"
            },
            {
              "name": "mood",
              "label": "心情（0 很低落 – 10 很好）",
              "type": "number",
              "min": 0,
              "max": 10
            },
            {
              "name": "irritability",
              "label": "烦躁／易怒（0–10）",
              "type": "number",
              "min": 0,
              "max": 10
            },
            {
              "name": "anxiety",
              "label": "焦虑（0–10）",
              "type": "number",
              "min": 0,
              "max": 10
            },
            {
              "name": "practices",
              "label": "今天做了",
              "type": "multi_choice",
              "options": [
                "呼吸空间/STOP",
                "思维记录",
                "愉快/掌控活动",
                "运动",
                "正念练习",
                "说出需要"
              ]
            },
            {
              "name": "note",
              "label": "今天的一件小事（好的或难的）",
              "type": "text",
              "hint": "比如：陪孩子搭了 10 分钟积木"
            }
          ]
        },
        {
          "id": "week",
          "title": "每周回顾（周末填）",
          "repeatable": false,
          "fields": [
            {
              "name": "warning_signs",
              "label": "这周出现的预警信号",
              "type": "multi_choice",
              "options": [
                "睡眠变差",
                "更容易发火",
                "对什么都没兴趣",
                "想躲开家人",
                "反复回想旧事",
                "觉得没有希望"
              ]
            },
            {
              "name": "what_helped",
              "label": "这周最有帮助的一件事",
              "type": "textarea",
              "print_lines": 1
            },
            {
              "name": "next_week",
              "label": "下周想多做一点的",
              "type": "textarea",
              "print_lines": 1
            }
          ]
        }
      ],
      "safety_note": "如果出现伤害自己的念头，或者感到彻底无望，请尽快联系医生、心理咨询师或当地心理援助热线，不要等。"
    },
    {
      "id": "thought_record",
      "title": "思维记录表",
      "category": "想法",
      "when_to_use": "情绪突然变差、事后还在心里反复想的时候填。最好当天写。",
      "how_to_fill": "先写客观发生了什么，再写情绪和强度、脑子里冒出的原话；对照 10 种认知扭曲勾选，然后列证据、写一个自己真信的平衡想法，最后重新给情绪打分。",
      "sources": [
        {
          "book": "《伯恩斯新情绪疗法》（戴维·伯恩斯）",
          "chapter": "第3、4章",
          "note": "10 种认知扭曲；三栏法／不良想法日常记录"
        },
        {
          "book": "《抑郁症自救手册》（莫妮克·汤普森）",
          "chapter": "第3章及附录",
          "note": "思维记录、检视刺激性想法（证据支持／反对）"
        },
        {
          "book": "《抑郁症自救手册》（莫妮克·汤普森）",
          "chapter": "第5章",
          "note": "TANS 情绪调节策略"
        }
      ],
      "sections": [
        {
          "id": "main",
          "title": "记录",
          "repeatable": false,
          "fields": [
            {
              "name": "datetime",
              "label": "日期和时间",
              "type": "datetime"
            },
            {
              "name": "situation",
              "label": "情境：只写客观事实（谁、在哪、发生了什么）",
              "type": "textarea",
              "print_lines": 2
            },
            {
              "name": "emotions",
              "label": "情绪和强度",
              "type": "textarea",
              "hint": "例如：愤怒 80%，委屈 60%",
              "print_lines": 1
            },
            {
              "name": "emotion_before",
              "label": "最强的那个情绪有多强",
              "type": "number",
              "min": 0,
              "max": 100,
              "unit": "%"
            },
            {
              "name": "automatic_thoughts",
              "label": "自动想法：当时脑子里冒出的原话",
              "type": "textarea",
              "print_lines": 2
            },
            {
              "name": "distortions",
              "label": "认知扭曲（可多选）",
              "type": "multi_choice",
              "options": [
                "非黑即白",
                "过度概括",
                "心理过滤",
                "否定正面",
                "妄下结论（读心术／先知错误）",
                "放大或缩小",
                "情绪推理",
                "“应该”句式",
                "贴标签",
                "个人化"
              ]
            },
            {
              "name": "evidence_for",
              "label": "支持这个想法的证据",
              "type": "textarea",
              "print_lines": 1
            },
            {
              "name": "evidence_against",
              "label": "不支持的证据／例外",
              "type": "textarea",
              "print_lines": 2
            },
            {
              "name": "balanced_thought",
              "label": "更平衡的想法（如果好朋友遇到，我会对他说什么？）",
              "type": "textarea",
              "print_lines": 2
            },
            {
              "name": "tans",
              "label": "还用了哪种方法",
              "type": "multi_choice",
              "options": [
                "T 认知重构：这个想法准确、有益吗？",
                "A 接纳：给情绪留出位置",
                "N 正常化：大多数人遇到也会这样",
                "S 自我关怀：对朋友我会怎么说"
              ]
            },
            {
              "name": "emotion_after",
              "label": "现在这个情绪有多强",
              "type": "number",
              "min": 0,
              "max": 100,
              "unit": "%"
            },
            {
              "name": "outcome",
              "label": "接下来我打算怎么做",
              "type": "textarea",
              "print_lines": 1
            }
          ]
        }
      ],
      "reference": {
        "title": "10 种认知扭曲速查（伯恩斯第3章）",
        "items": [
          "非黑即白：不完美就等于彻底失败",
          "过度概括：一件坏事当成“永远都这样”",
          "心理过滤：只盯着一个负面细节",
          "否定正面：好的事“不算数”",
          "妄下结论：读心术（认定别人在负面地看你）、先知错误（把坏的预测当事实）",
          "放大或缩小：放大自己的错，缩小自己的好",
          "情绪推理：“我感觉是这样，所以就是这样”",
          "“应该”句式：用“应该／必须”要求自己或别人",
          "贴标签：用一个负面标签概括一个人",
          "个人化：把不是自己造成的事揽到自己身上"
        ]
      },
      "example": {
        "situation": "晚饭时家里长辈给孩子喂饭，你说让孩子自己吃，伴侣说“算了别争了”。",
        "emotions": "愤怒 85%，委屈 70%",
        "emotion_before": 85,
        "automatic_thoughts": "“他／她永远不站在我这边。”“在这个家里我说话不算数。”",
        "distortions": [
          "过度概括",
          "妄下结论（读心术／先知错误）",
          "贴标签"
        ],
        "evidence_for": "这次确实没有支持我。",
        "evidence_against": "上个月孩子看电视的事，伴侣主动去和长辈商量过。这次可能只是不想当着孩子吵。",
        "balanced_thought": "这次伴侣选择先息事宁人，不代表永远。我可以晚上单独跟他／她商量喂饭的事。",
        "tans": [
          "T 认知重构：这个想法准确、有益吗？",
          "S 自我关怀：对朋友我会怎么说"
        ],
        "emotion_after": 45,
        "outcome": "孩子睡后约伴侣谈 15 分钟，用自我主张沟通准备表先写一下。"
      }
    },
    {
      "id": "anger_quick_card",
      "title": "发脾气时的快速应对卡",
      "category": "当下",
      "when_to_use": "感到火往上冲的那一刻用。可以剪下来放在钱包里，或者存在手机里。",
      "how_to_fill": "先做 STOP（几秒钟），时间允许就做三分钟呼吸空间，然后选一扇“门”。平时先填好下面的个人信号和“缓一下”的说法。",
      "sources": [
        {
          "book": "《抑郁症自救手册》（莫妮克·汤普森）",
          "chapter": "第5章",
          "note": "策略 11：STOP"
        },
        {
          "book": "《抑郁症的正念认知疗法》第2版（西格尔、威廉斯、蒂斯代尔）",
          "chapter": "第10、13、18章",
          "note": "三分钟呼吸空间（书第197–198、281–282、374–380页）"
        },
        {
          "book": "《伯恩斯新情绪疗法》（戴维·伯恩斯）",
          "chapter": "第7章",
          "note": "检查怒气的两个问题、离开现场打断“重播”"
        }
      ],
      "steps": [
        {
          "title": "STOP（几秒钟）",
          "items": [
            "S 停一下：先不说话、不动手。孩子在场先确认孩子安全",
            "T 深呼吸：慢慢吸一口气，再慢慢呼出",
            "O 观察：不加评判地看看现在是什么情况、身体有什么信号",
            "P 选一种方式回应，不被冲动推着走"
          ]
        },
        {
          "title": "三分钟呼吸空间（沙漏形状）",
          "items": [
            "① 觉知（约1分钟）：有什么想法？有什么情绪（“这里有愤怒”）？身体哪里紧、哪里热？",
            "② 聚焦（约1分钟）：把注意力收到腹部随呼吸的起伏，走神了就带回来",
            "③ 扩展（约1分钟）：觉知扩展到整个身体；吸气时“进入”紧绷处，呼气时松开一点"
          ]
        },
        {
          "title": "选一扇门",
          "items": [
            "重新进入：带着新的状态回去，但不在气头上开战",
            "身体之门：继续陪着身体感受，太强就回到呼吸或脚底",
            "想法之门：把念头写下来，晚点再看哪些是事实",
            "行动之门：做一件照顾自己的小事（喝杯热水、走 10 分钟）"
          ]
        },
        {
          "title": "问自己两个问题（伯恩斯第7章）",
          "items": [
            "对方是故意、没必要地伤害我吗？",
            "我现在发火，对达到我的目标有用吗？"
          ]
        }
      ],
      "sections": [
        {
          "id": "prep",
          "title": "平时先填好",
          "repeatable": false,
          "fields": [
            {
              "name": "body_signals",
              "label": "我的“快要失控”身体信号",
